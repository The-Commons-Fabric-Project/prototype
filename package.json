{
    "name": "prototype",
    "private": true,
    "workspaces": ["packages/*", "frontend", "backend"],
    "scripts": {
        "dev": "concurrently -n frontend,backend -c blue,green \"npm run dev -w frontend\" \"npm run dev -w backend\"",
        "build": "npm run build --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "preview": "npm run preview --workspaces --if-present"
    },

    "devDependencies": {
        "@prototype/eslint-config": "*",
        "concurrently": "^9.1.2"
    }
}