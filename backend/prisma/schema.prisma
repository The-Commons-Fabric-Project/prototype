// This is the Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Source of truth for the DB structure. The human-readable diagram lives in
// db/schema.dbml. Note the SQLite-specific translation choices vs. that DBML:
//   - SQLite has no enum type   -> org_tags is stored as a plain String (see OrganizationTag.tag)
//   - SQLite autoincrement is Int only -> all `bigint` PKs/FKs become Int
//   - varchar(n) native types are not enforced by SQLite -> lengths dropped
//   - Postgres `~*` regex CHECKs cannot run on SQLite -> those validations move
//     to the application layer. The simple non-regex CHECKs (e.g. length(trim(x)) > 0)
//     are added by hand in the initial migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             Int          @id @default(autoincrement())
  fullname       String
  email          String       @unique
  passwordHash   String       @map("password_hash") // argon2id PHC string - the salt and params are encoded in it
  organizationId Int          @map("organization_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id])
  events         Event[]

  @@map("users")
}

model Event {
  id               Int      @id @default(autoincrement())
  title            String
  ownerId          Int      @map("owner_id")
  startsAt         DateTime @map("starts_at")
  endsAt           DateTime @map("ends_at")
  location         String?
  description      String?
  thumbnail        String? // file path of image e.g. ./public/event_images/example.jpg
  registrationLink String?  @map("registration_link")
  volunteerContact String?  @map("volunteer_contact")
  createdAt        DateTime @default(now()) @map("created_at")

  owner            User     @relation(fields: [ownerId], references: [id])

  @@map("events")
}

model Organization {
  id      Int                @id @default(autoincrement())
  name    String
  logo    String? // file path of image e.g. ./public/organization_logos/example.jpg
  blurb   String? // short description of the organization
  contact String?
  website String?

  users   User[]
  tags    OrganizationTag[]

  @@map("organizations")
}

// org_tags in the DBML is a Postgres enum. SQLite has no enums, so `tag` is a
// String. The allowed values are the org_tags enum in src/docs/db/schema.dbml,
// enforced by a CHECK in the initial migration and by ORG_TAGS in
// src/models/orgTags.ts. They are deliberately not restated here - that would be
// another copy to keep in sync, and src/models/orgTags.ts explains the rest.
model OrganizationTag {
  organizationId Int          @map("organization_id")
  tag            String

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, tag])
  @@map("organizations_tags")
}

